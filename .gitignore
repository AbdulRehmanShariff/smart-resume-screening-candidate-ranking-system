# ============================================================
# Smart Resume Screening & Candidate Ranking System
# .gitignore
# ============================================================

# ---- Environment & Secrets (NEVER COMMIT) ----
.env
.env.local
.env.production
.env.staging
*.key
*.pem
secrets/

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.whl
MANIFEST
.installed.cfg
*.spec

# ---- Virtual Environments ----
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ---- Testing & Coverage ----
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# ---- Flask / Application ----
instance/
.webassets-cache
logs/
*.log

# ---- Uploads (local dev only) ----
backend/uploads/

# ---- Flask-Migrate ----
# Keep migrations folder but ignore SQLite dev databases
*.db
*.sqlite3

# ---- Node.js / Frontend ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
frontend/dist/
frontend/build/
frontend/.next/
frontend/out/
.npm
.yarn

# ---- IDE & Editor ----
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---- Docker ----
.dockerignore

# ---- Misc ----
*.bak
*.tmp
*.temp
.cache/
