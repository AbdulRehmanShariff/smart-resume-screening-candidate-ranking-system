# ==============================================================
# Smart Resume Screening & Candidate Ranking System
# Environment Variables Template
# ==============================================================
#
# INSTRUCTIONS:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in every value marked with <your-value-here>
#   3. NEVER commit .env to version control
#   4. Rotate all secrets before deploying to production
#
# ==============================================================


# --------------------------------------------------------------
# Application
# --------------------------------------------------------------
FLASK_ENV=development
FLASK_HOST=0.0.0.0
FLASK_PORT=5000


# --------------------------------------------------------------
# Security Secrets
# --------------------------------------------------------------
# Generate strong secrets with:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
SECRET_KEY=<your-flask-secret-key-here>
JWT_SECRET_KEY=<your-jwt-secret-key-here>


# --------------------------------------------------------------
# Database
# --------------------------------------------------------------
# Format: postgresql://username:password@host:port/database_name
#
# Local development:
DATABASE_URL=postgresql://postgres:<your-password>@localhost:5432/smart_resume_db

# Test database (used when FLASK_ENV=testing):
TEST_DATABASE_URL=postgresql://postgres:<your-password>@localhost:5432/smart_resume_test_db

# Cloud (Neon PostgreSQL — Stage deployment):
# DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require


# --------------------------------------------------------------
# CORS — Allowed Frontend Origins
# --------------------------------------------------------------
# Comma-separated list. No trailing slashes.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173


# --------------------------------------------------------------
# Email (SMTP)
# --------------------------------------------------------------
# For Gmail: enable 2FA and generate an App Password.
# https://myaccount.google.com/apppasswords
#
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=<your-email@gmail.com>
MAIL_PASSWORD=<your-gmail-app-password>
MAIL_DEFAULT_SENDER=noreply@smartresume.com


# --------------------------------------------------------------
# File Storage
# --------------------------------------------------------------
# Local path for uploaded files (relative to backend/ directory)
# In production, this will be replaced by cloud storage (S3/GCS)
UPLOAD_FOLDER=uploads

# Maximum file upload size in bytes (default: 10 MB)
MAX_CONTENT_LENGTH=10485760


# --------------------------------------------------------------
# Logging
# --------------------------------------------------------------
# LOG_LEVEL options: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=DEBUG
LOG_FILE=logs/app.log


# --------------------------------------------------------------
# AI Services (Enabled in Stage 4)
# --------------------------------------------------------------
# Google Gemini API
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=<your-gemini-api-key-here>

# Gemini model to use for resume analysis and chat
GEMINI_MODEL=gemini-1.5-pro
